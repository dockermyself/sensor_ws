<?xml version="1.0"?>
<launch>
  <!-- Temperature Sensor Node -->
  <node name="temperature_sensor" pkg="sensor_package" type="temperature_sensor.py" output="screen">
    <param name="publish_rate" value="2.0"/>
    <param name="sensor_frame" value="temp_frame"/>
    <param name="min_temp" value="18.0"/>
    <param name="max_temp" value="28.0"/>
    <param name="noise_level" value="0.3"/>
  </node>

  <!-- Humidity Sensor Node -->
  <node name="humidity_sensor" pkg="sensor_package" type="humidity_sensor.py" output="screen">
    <param name="publish_rate" value="2.0"/>
    <param name="sensor_frame" value="humidity_frame"/>
    <param name="min_humidity" value="40.0"/>
    <param name="max_humidity" value="70.0"/>
    <param name="noise_level" value="1.5"/>
  </node>

  <!-- Sensor Manager Node -->
  <node name="sensor_manager" pkg="sensor_package" type="sensor_manager.py" output="screen">
    <param name="publish_rate" value="1.0"/>
    <param name="sensor_timeout" value="3.0"/>
  </node>
</launch>